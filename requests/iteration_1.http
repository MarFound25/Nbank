// ТЕСТЫ НА ДОПУСТИМЫЕ СИМВОЛЫ В USERNAME

### Positive: Username can contain dots
POST http://localhost:4111/api/v1/admin/users
Content-Type: application/json
Basic YWRtaW46YWRtaW4=

{
  "username": "john.doe",
  "password": "Test1234!",
  "name": "John Doe",
  "role": "USER"
}

### Positive: Username can contain hyphens
POST http://localhost:4111/api/v1/admin/users
Content-Type: application/json
Basic YWRtaW46YWRtaW4=

{
  "username": "john-doe",
  "password": "Test1234!",
  "name": "John Doe",
  "role": "USER"
}

### Positive: Username can contain underscores
POST http://localhost:4111/api/v1/admin/users
Content-Type: application/json
Basic YWRtaW46YWRtaW4=

{
  "username": "john_doe",
  "password": "Test1234!",
  "name": "John Doe",
  "role": "USER"
}

### Positive: Username can contain numbers
POST http://localhost:4111/api/v1/admin/users
Content-Type: application/json
Basic YWRtaW46YWRtaW4=

{
  "username": "john123",
  "password": "Test1234!",
  "name": "John Doe",
  "role": "USER"
}

### Negative: Username cannot contain spaces
POST http://localhost:4111/api/v1/admin/users
Content-Type: application/json
Basic YWRtaW46YWRtaW4=

{
  "username": "john doe",
  "password": "Test1234!",
  "name": "John Doe",
  "role": "USER"
}


// ТЕСТЫ ДЛЯ ПОЛЬЗОВАТЕЛЯ


### Логин пользователя testuser1 и получение токена
POST http://localhost:4111/api/v1/auth/login
Content-Type: application/json

{
    "username": "testuser1",
    "password": "Test1234!"
}

> {%
    client.global.set("auth_token", response.body.token);
%}

### Positive: User views their accounts
GET http://localhost:4111/api/v1/accounts
Authorization: Bearer {{auth_token}}

### Positive: User creates new account
POST http://localhost:4111/api/v1/accounts
Authorization: Bearer {{auth_token}}
Content-Type: application/json


// ТЕСТЫ НА ДЕПОЗИТЫ

### Positive: User makes a deposit to own account
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 1000.00
}

### Negative: User tries to deposit negative amount
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": -100.00
}

### Negative: User tries to deposit more than max limit (5000)
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 5001.00
}

### Negative: User tries to deposit to someone else's account
POST http://localhost:4111/api/v1/accounts/someone-elses-acc/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 100.00
}

### Negative: User tries to deposit to non-existent account
POST http://localhost:4111/api/v1/accounts/non-existent-acc/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 100.00
}

### Positive Boundary: User deposits exactly max limit (5000.00)
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 5000.00
}

### Positive Boundary: User deposits minimum positive amount (0.01)
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 0.01
}

### Negative Boundary: User deposits amount just above max limit (5000.01)
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 5000.01
}

### Positive Boundary: User deposits amount just below max limit (4999.99)
POST http://localhost:4111/api/v1/accounts/acc-123/deposit
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "amount": 4999.99
}

// ТЕСТЫ НА ПЕРЕВОДЫ

### Positive: Transfer between user's own accounts
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 500.00
}

### Negative: Transfer amount exceeding balance
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 999999.00
}

### Negative: Transfer to non-existent account
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "non-existent-acc",
    "amount": 100.00
}

### Negative: Transfer with negative amount
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": -50.00
}

### Negative: Transfer with amount zero
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 0.00
}

### Negative: Transfer amount exceeding max limit (10000)
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 10001.00
}

### Negative: Transfer from someone else's account
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "someone-elses-acc",
    "toAccountId": "acc-456",
    "amount": 100.00
}

### Positive Boundary: Transfer exactly max limit (10000.00)
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 10000.00
}

### Positive Boundary: Transfer minimum positive amount (0.01)
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 0.01
}

### Negative Boundary: Transfer amount just above max limit (10000.01)
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 10000.01
}

### Positive Boundary: Transfer amount just below max limit (9999.99)
POST http://localhost:4111/api/v1/transfers
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "fromAccountId": "acc-123",
    "toAccountId": "acc-456",
    "amount": 9999.99
}

// ТЕСТЫ НА ТРАНЗАКЦИИ

